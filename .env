FFCODE_1080=ffmpeg -i '{}' -progress '{}' -vf "drawtext=text='Z5Tech_BD':fontcolor=white@0.3:fontsize=26:x=10:y=10" -map 0:v:0 -map 0:a:m:language:hin -map 0:s:m:language:eng -c:v libx264 -crf 28 -c:s copy -pix_fmt yuv420p -s 1920x1080 -b:v 150k -c:a libopus -b:a 36k -preset ultrafast -threads 0 -metadata title='[t.me/Z5Tech_BD]' -metadata:s:s title='[Z5Tech_BD]' -metadata:s:a title='[Z5Tech_BD]' -metadata author='ABHINAI' -metadata:s:v title='[Z5Tech_BD]' '{}' -y
FFCODE_720=ffmpeg -i '{}' -progress '{}' -vf "drawtext=text='Z5Tech_BD':fontcolor=white@0.3:fontsize=26:x=10:y=10" -map 0:v:0 -map 0:a:m:language:hin -map 0:s:m:language:eng -c:v libx264 -crf 28 -c:s copy -pix_fmt yuv420p -s 1280x720 -b:v 150k -c:a libopus -b:a 35k -preset ultrafast -threads 0 -metadata title='[t.me/Z5Tech_BD]' -metadata:s:s title='[Z5Tech_BD]' -metadata:s:a title='[Z5Tech_BD]' -metadata author='ABHINAI' -metadata:s:v title='[Z5Tech_BD]' '{}' -y
